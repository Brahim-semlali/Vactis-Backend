# ============================================================
#  .gitignore — Backend Spring Boot (StageLabo-back)
# ============================================================

# ── Build Java ───────────────────────────────────────────────
target/
build/
out/
*.class
*.war
*.ear
!**/mvnw
!**/.mvn/wrapper/maven-wrapper.jar

# ── Maven wrapper ────────────────────────────────────────────
.mvn/wrapper/maven-wrapper.jar

# ── Secrets & configuration sensible ─────────────────────────
.env
.env.*
!.env.example
src/main/resources/.env
src/main/resources/.env.*
!src/main/resources/.env.example
application-prod.properties
application-prod.yml
application-prod.yaml
application-local.properties
application-local.yml
application-local.yaml
**/application-*-local.properties
**/application-*-local.yml
**/application-*-local.yaml

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── IDE — IntelliJ IDEA ──────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── IDE — Spring Tool Suite (STS) ────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# ── IDE — VS Code ────────────────────────────────────────────
.vscode/

# ── IDE — NetBeans ───────────────────────────────────────────
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Divers ───────────────────────────────────────────────────
hs_err_pid*
replay_pid*
