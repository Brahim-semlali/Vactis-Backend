# Copier ce fichier vers .env et remplir les valeurs (ne jamais committer .env)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vactis_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker (docker-compose.yml dans ce dossier)
POSTGRES_DB=vactis_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8083
# Tentatives max (3) et durée suspension (2 min) : table auth_settings en BDD
